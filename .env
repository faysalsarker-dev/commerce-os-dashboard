# VITE_API_URL=https://commerce-os-server.vercel.app/api/v1

# Socket.IO requires a persistent Node.js server (e.g. http://localhost:5000 locally or Railway/Render in production).
# Note: Vercel serverless functions do NOT support persistent WebSockets.
VITE_API_SOCKET_URL=http://localhost:5000

# Local server setup (uncomment when running backend locally via npm run dev in commerce-os-server):
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_SOCKET_URL=http://localhost:5000
